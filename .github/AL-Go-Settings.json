{
  "githubRunnerShell": "powershell",
  "conditionalSettings": [
    {
      "workflows": [
        "CI/CD"
      ],
      "settings": {
        "workflowConcurrency": [
          "group: ${{ github.workflow }}-${{ github.ref }}",
          "cancel-in-progress: true"
        ]
      }
    }
  ],
  "$schema": "https://raw.githubusercontent.com/microsoft/AL-Go/827187f5045047e373a0f462021f5d4f1fcf2bd8/Actions/.Modules/settings.schema.json",
  "templateUrl": "https://github.com/businesscentralapps/tmpcJVkFH-PTE@main",
  "githubRunner": "windows-latest",
  "useApproximateVersion": true,
  "MicrosoftTelemetryConnectionString": "",
  "useCompilerFolder": true,
  "incrementalBuilds": {
    "onPush": true
  },
  "type": "PTE",
  "UseProjectDependencies": true,
  "doNotPublishApps": true
}
